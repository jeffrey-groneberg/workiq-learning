---
// One of the app's illustrations, optimized by Astro, with its caption from the app.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<figure>
	<Image src={src} alt={alt} width={960} />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	figcaption {
		margin-top: 0.5rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		text-align: center;
	}
</style>
