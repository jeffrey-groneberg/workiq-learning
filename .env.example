# Optional defaults. Copy to .env, or enter these in the app's Connection settings.
# IDs are not secrets. Never put access tokens or client secrets in this file.
WORKIQ_TENANT_ID=
WORKIQ_CLIENT_ID=
# Harness model for the MCP tab (Azure OpenAI; authenticated with your Azure CLI login).
WORKIQ_LLM_ENDPOINT=
WORKIQ_LLM_DEPLOYMENT=
# Optional: low, medium or high to show reasoning summaries. Empty uses the model default.
WORKIQ_LLM_REASONING=
